DATABASE_URL=sqlite:///./tracker.db
# Railway Postgres: set automatically when you add Postgres plugin, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/railway
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SCAN_INTERVAL_SEC=300
VIDEOS_PER_CREATOR=8
MAX_WORKERS=10
MAX_NEW_CREATORS_PER_SWEEP=15
HISTORY_CREATORS_PER_SWEEP=5
HISTORY_VIDEOS_PER_SWEEP=25
HISTORY_MAX_VIDEOS=300
RECENT_CREATORS_PER_SWEEP=30
RUN_WORKER=True
